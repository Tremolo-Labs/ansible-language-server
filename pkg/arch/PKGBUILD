arch=('any')
url="https://github.com/ansible/ansible-language-server"
license=('GPL3')
depends=(
    'python>=3.10'
    'python-pygls>=1.3.0'
    'python-ruamel-yaml>=0.18.0'
    'python-attrs>=23.0.0'
    'python-tree-sitter>=0.23.0'
    'python-lsprotocol>=2024.0.0'
    'python-ansible-runner>=2.4.0'
    'ansible>=10.0.0'
    'python-jinja>=3.1.0'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-hatchling'
)
optdepends=(
    'python-tree-sitter-yaml: YAML parsing support'
    'python-tree-sitter-jinja2: Jinja2 template support'
)
provides=('ansible-language-server')
conflicts=('nodejs-ansible-language-server')
source=()

# For local development, override source in makepkg.conf or use:
# makepkg -e  (to skip source extraction, build from current directory)

build() {
    cd "${srcdir}/.." || cd "${startdir}/../.."
    python -m build --wheel --no-isolation
}

package() {
    cd "${srcdir}/.." || cd "${startdir}/../.."
    python -m installer --destdir="$pkgdir" dist/*.whl
}
